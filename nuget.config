<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local NuGet configuration. The user-level NuGet.Config on this machine has no sources,
     so the official feed is declared here instead of changing machine/user configuration. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <config>
    <!-- Keep downloaded packages inside the repo so the project is self-contained and easy to remove. -->
    <add key="globalPackagesFolder" value=".tools/nuget-packages" />
  </config>
</configuration>
