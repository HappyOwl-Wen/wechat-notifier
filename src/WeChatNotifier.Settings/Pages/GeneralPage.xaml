<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WeChatNotifier.Settings.Pages.GeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WeChatNotifier.Settings">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageStack}">
            <TextBlock Margin="1,0,0,12" Style="{StaticResource TitleTextBlockStyle}" Text="常规" />

            <local:SettingsCard
                Description="登录 Windows 后在后台启动，等待微信运行。也可以在任务管理器的「启动应用」中关闭。"
                Glyph="&#xE7E8;"
                Header="开机时启动">
                <ToggleSwitch IsOn="{x:Bind VM.StartWithWindows, Mode=TwoWay}" Style="{StaticResource CardToggle}" />
            </local:SettingsCard>

            <local:SettingsCard
                Description="在任务栏右下角显示 WeChat Notifier 图标：单击打开设置，右键单击可以暂停或退出。隐藏后，再次运行程序即可打开设置。"
                Glyph="&#xE7F4;"
                Header="显示托盘图标">
                <ToggleSwitch IsOn="{x:Bind VM.ShowTrayIcon, Mode=TwoWay}" Style="{StaticResource CardToggle}" />
            </local:SettingsCard>

            <local:SettingsCard
                Description="默认不通知：你正在看微信。微信在前台时基本不会闪烁任务栏，所以这一项很少起作用。"
                Glyph="&#xE8BD;"
                Header="微信在前台时也通知">
                <ToggleSwitch IsOn="{x:Bind VM.NotifyWhileWeChatFocused, Mode=TwoWay}" Style="{StaticResource CardToggle}" />
            </local:SettingsCard>
        </StackPanel>
    </ScrollViewer>
</Page>
